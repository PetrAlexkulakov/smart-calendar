# Скопируй в .env и заполни: cp .env.example .env

# --- База данных ---
# Локальный Postgres из docker-compose.yml
DATABASE_URL="postgresql://calendar:calendar@localhost:5432/smart_calendar?schema=public"

# --- Сервер ---
NODE_ENV=development
PORT=3000
# Origin фронтенда, нужен для CORS с credentials
WEB_ORIGIN=http://localhost:5173

# --- JWT ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Web Push (VAPID) ---
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
