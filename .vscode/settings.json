{
  // По Ctrl+S: Prettier расставляет отступы и переносы, затем ESLint
  // чинит то, что умеет чинить сам — сортирует импорты, убирает лишнее.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Путь к конфигу задан явно: в глобальных настройках может стоять
  // prettier.configPath от другого проекта, и тогда Prettier ищет файл,
  // которого здесь нет. Вместе с requireConfig это выключает
  // форматирование совсем — молча, без единой ошибки.
  "prettier.configPath": ".prettierrc.json",

  // Автосохранение с задержкой несовместимо с форматированием по Ctrl+S:
  // файл успевает сохраниться сам (без форматирования), и к моменту
  // нажатия Ctrl+S сохранять уже нечего — событие не срабатывает.
  "files.autoSave": "off",

  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },

  // Монорепо: без этого ESLint ищет конфиг рядом с файлом и не находит.
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.useFlatConfig": true,

  // Редактор должен брать TypeScript из проекта, а не встроенный:
  // у нас 6.x, встроенный в VS Code обычно старее и подсвечивает
  // несуществующие ошибки.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Импорты автоматически подставляются с расширением .ts/.tsx —
  // так же, как написан весь остальной код.
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "javascript.preferences.importModuleSpecifierEnding": "js",

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "apps/api/generated": true,
    "design": true
  }
}
